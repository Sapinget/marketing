{
  "version": "1.0.0",
  "name": "AI Workspace",
  "purpose": "Model-agnostic operating system for Claude, Codex, OpenCode, and other AI agents.",
  "defaultWorkflow": [
    "clarify_brief",
    "route_to_crew",
    "inspect_context",
    "produce_artifact",
    "verify",
    "summarize_next_steps"
  ],
  "crews": [
    {
      "id": "developers",
      "name": "Developers",
      "tagline": "Ship code faster, from scaffold to QA",
      "leadWhen": [
        "scaffold or modify software",
        "debug production behavior",
        "write or improve tests",
        "review architecture or implementation"
      ],
      "skills": [
        "superpower",
        "context7",
        "mcp-builder",
        "skill-creator",
        "webapp-testing",
        "claude-mem"
      ],
      "deliverables": [
        "implementation plan",
        "code changes",
        "tests",
        "QA checklist",
        "release notes"
      ],
      "qualityBar": [
        "small focused changes",
        "repo patterns followed",
        "security boundaries respected",
        "tests or explicit verification included"
      ]
    },
    {
      "id": "design",
      "name": "Design",
      "tagline": "UI that never looks templated",
