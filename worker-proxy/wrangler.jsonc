{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marketing",
  "main": "src/index.js",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "vars": {
    "ORIGIN_URL": "https://nominations-rabbit-wages-cases.trycloudflare.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
